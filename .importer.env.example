# Local Firefly III Data Importer settings for docker-compose.override.yml
# Copy this file to ".importer.env" and fill in the token/client values.

APP_ENV=local
APP_DEBUG=false
TZ=Europe/Amsterdam
TRUSTED_PROXIES=**

# Internal Docker network URL to Firefly III core container.
FIREFLY_III_URL=http://app:8080

# Optional: URL shown in links/buttons when the importer redirects back to Firefly III.
VANITY_URL=http://localhost:9999

# Choose one auth method:
# 1) Personal access token (recommended for local development):
FIREFLY_III_ACCESS_TOKEN=
# 2) OR OAuth client id:
FIREFLY_III_CLIENT_ID=

# Security hardening for auto-import endpoints (leave disabled unless needed).
AUTO_IMPORT_SECRET=
CAN_POST_AUTOIMPORT=false
CAN_POST_FILES=false

# Keep strict TLS checks by default.
VERIFY_TLS_SECURITY=true

# Submission throughput tuning
# Persist submission state every N rows instead of every row.
SUBMISSION_SAVE_EVERY_N_ROWS=20
# Skip per-transaction tag update roundtrip (can be re-enabled if import tags are required).
SUBMISSION_SKIP_TAG_UPDATES=true
# Page size for duplicate preloading index over /v1/transactions.
SUBMISSION_DUPLICATE_INDEX_PAGE_SIZE=200
# Safety limit for duplicate preloading pagination.
SUBMISSION_DUPLICATE_INDEX_MAX_PAGES=200
